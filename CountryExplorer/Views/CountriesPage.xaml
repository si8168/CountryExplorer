<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CountryExplorer.Views.CountriesPage"
             Title="Country Explorer"
             BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- Controls Header -->
        <VerticalStackLayout Grid.Row="0" Padding="15,10,15,5" Spacing="10">
            <SearchBar x:Name="CountrySearchBar"
                       Placeholder="Search country name..."
                       TextChanged="OnSearchOrFilterChanged" />

            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Picker x:Name="RegionPicker"
                        Title="Select Region"
                        SelectedIndexChanged="OnSearchOrFilterChanged">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>All Regions</x:String>
                            <x:String>Africa</x:String>
                            <x:String>Americas</x:String>
                            <x:String>Asia</x:String>
                            <x:String>Europe</x:String>
                            <x:String>Oceania</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Button Grid.Column="1"
                        Text="Reload"
                        Clicked="OnReloadClicked"
                        VerticalOptions="Center" />
            </Grid>

            <Label x:Name="ResultCountLabel"
                   Text="Loading countries..."
                   FontSize="13"
                   TextColor="Gray"
                   Margin="5,0,0,0" />
        </VerticalStackLayout>

        <!-- Loading State Indicator -->
        <VerticalStackLayout x:Name="LoadingView"
                             Grid.Row="2"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="15"
                             IsVisible="False">
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="True"
                               HeightRequest="45"
                               WidthRequest="45"
                               Color="#2196F3" />
            <Label Text="Fetching latest data..." FontSize="14" TextColor="Gray" />
        </VerticalStackLayout>

        <!-- Error / Empty State Message -->
        <VerticalStackLayout x:Name="StatusMessageView"
                             Grid.Row="2"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Padding="30"
                             Spacing="15"
                             IsVisible="False">
            <Label x:Name="StatusMessageLabel"
                   Text="No countries found."
                   HorizontalTextAlignment="Center"
                   FontSize="16"
                   TextColor="Gray" />
            <Button Text="Try Again" Clicked="OnReloadClicked" WidthRequest="140" />
        </VerticalStackLayout>

        <!-- Main Countries List -->
        <CollectionView x:Name="CountriesCollectionView"
                        Grid.Row="2"
                        Margin="15,5,15,10"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,12"
                            Padding="12"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                        <Grid ColumnDefinitions="90, *" ColumnSpacing="15">

                            <!-- Remote Flag Image -->
                            <Image Grid.Column="0"
                                   Source="{Binding FlagUrl, FallbackValue='?'}"
                                   Aspect="AspectFit"
                                   HeightRequest="60"
                                   WidthRequest="90"
                                   VerticalOptions="Center" />

                            <!-- Country Summary -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="{Binding CommonName}"
                                       FontAttributes="Bold"
                                       FontSize="17" />
                                <Label Text="{Binding CapitalDisplay, StringFormat='Capital: {0}'}"
                                       FontSize="13"
                                       TextColor="Gray" />
                                <Label Text="{Binding Region, StringFormat='Region: {0}'}"
                                       FontSize="13"
                                       TextColor="Gray" />
                                <Label Text="{Binding FormattedPopulation, StringFormat='Pop: {0}'}"
                                       FontSize="12"
                                       TextColor="#2196F3" />
                            </VerticalStackLayout>
                        </Grid>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCountrySelected" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>