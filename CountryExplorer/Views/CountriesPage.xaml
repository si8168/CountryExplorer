<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CountryExplorer.Views.CountriesPage"
             Title="Country Explorer"
             BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="FavFilterToolbarItem" Text="❤️ Favorites Only" Clicked="OnToggleFavoritesFilterClicked" Priority="0" />
        <ToolbarItem Text="🎲 Random" Clicked="OnRandomCountryClicked" Priority="1" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- Controls Header -->
        <VerticalStackLayout Grid.Row="0" Padding="15,10,15,5" Spacing="8">
            <SearchBar x:Name="CountrySearchBar"
                       Placeholder="Search country name..."
                       TextChanged="OnSearchOrFilterChanged" />

            <Grid ColumnDefinitions="*, *, Auto" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Region" FontSize="11" TextColor="Gray" />
                    <Picker x:Name="RegionPicker" Title="Select Region" SelectedIndexChanged="OnSearchOrFilterChanged">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>All Regions</x:String>
                                <x:String>Africa</x:String>
                                <x:String>Americas</x:String>
                                <x:String>Asia</x:String>
                                <x:String>Europe</x:String>
                                <x:String>Oceania</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Sort By" FontSize="11" TextColor="Gray" />
                    <Picker x:Name="SortPicker" Title="Sort Order" SelectedIndexChanged="OnSearchOrFilterChanged">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Name (A-Z)</x:String>
                                <x:String>Name (Z-A)</x:String>
                                <x:String>Population (High-Low)</x:String>
                                <x:String>Population (Low-High)</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>

                <Button Grid.Column="2" Text="Reload" Clicked="OnReloadClicked" VerticalOptions="End" Margin="0,0,0,2" />
            </Grid>

            <!-- Quick Stats Summary Banner -->
            <Border StrokeShape="RoundRectangle 8" Padding="10" BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#1E293B}">
                <Grid ColumnDefinitions="*, *">
                    <VerticalStackLayout Grid.Column="0">
                        <Label x:Name="ResultCountLabel" Text="Loading..." FontSize="12" FontAttributes="Bold" TextColor="#2196F3" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                        <Label x:Name="TotalPopulationLabel" Text="Total Pop: 0" FontSize="12" TextColor="Gray" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- Main Content Grid -->
        <Grid Grid.Row="2">

            <VerticalStackLayout x:Name="LoadingView" VerticalOptions="Center" HorizontalOptions="Center" Spacing="15" IsVisible="False">
                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="True" HeightRequest="45" WidthRequest="45" Color="#2196F3" />
                <Label Text="Fetching latest data..." FontSize="14" TextColor="Gray" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="StatusMessageView" VerticalOptions="Center" HorizontalOptions="Center" Padding="30" Spacing="15" IsVisible="False">
                <Label x:Name="StatusMessageLabel" Text="No countries found." HorizontalTextAlignment="Center" FontSize="16" TextColor="Gray" />
                <Button Text="Try Again" Clicked="OnReloadClicked" WidthRequest="140" />
            </VerticalStackLayout>

            <RefreshView x:Name="CountryRefreshView" Refreshing="OnRefreshRequested">
                <CollectionView x:Name="CountriesCollectionView" Margin="15,5,15,10" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="12" StrokeShape="RoundRectangle 10" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                                <Grid ColumnDefinitions="80, *, Auto" ColumnSpacing="12">
                                    <Image Grid.Column="0" Source="{Binding FlagUrl, FallbackValue='?'}" Aspect="AspectFit" HeightRequest="55" WidthRequest="80" VerticalOptions="Center" />

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding CommonName}" FontAttributes="Bold" FontSize="16" />
                                        <Label Text="{Binding CapitalDisplay, StringFormat='Capital: {0}'}" FontSize="12" TextColor="Gray" />
                                        <Label Text="{Binding Region, StringFormat='Region: {0}'}" FontSize="12" TextColor="Gray" />
                                        <Label Text="{Binding FormattedPopulation, StringFormat='Pop: {0}'}" FontSize="12" TextColor="#2196F3" />
                                    </VerticalStackLayout>

                                    <!-- Favorite Button -->
                                    <Button Grid.Column="2" Text="{Binding FavoriteIcon}" FontSize="18" BackgroundColor="Transparent" Clicked="OnFavoriteButtonClicked" CommandParameter="{Binding .}" VerticalOptions="Center" HeightRequest="40" WidthRequest="45" />
                                </Grid>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCountrySelected" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>