<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CountryExplorer.Views.CountriesPage"
             Title="Country Explorer"
             BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="🎲 Random" Clicked="OnRandomCountryClicked" Priority="0" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, *">

        <!-- Controls Header -->
        <VerticalStackLayout Grid.Row="0" Padding="15,10,15,5" Spacing="8">
            <SearchBar x:Name="CountrySearchBar"
                       Placeholder="Search country name..."
                       TextChanged="OnSearchOrFilterChanged" />

            <Grid ColumnDefinitions="*, *, Auto" ColumnSpacing="10">
                <!-- Region Filter -->
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Region" FontSize="11" TextColor="Gray" />
                    <Picker x:Name="RegionPicker"
                            Title="Select Region"
                            SelectedIndexChanged="OnSearchOrFilterChanged">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>All Regions</x:String>
                                <x:String>Africa</x:String>
                                <x:String>Americas</x:String>
                                <x:String>Asia</x:String>
                                <x:String>Europe</x:String>
                                <x:String>Oceania</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>

                <!-- Sort Order -->
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Sort By" FontSize="11" TextColor="Gray" />
                    <Picker x:Name="SortPicker"
                            Title="Sort Order"
                            SelectedIndexChanged="OnSearchOrFilterChanged">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Name (A-Z)</x:String>
                                <x:String>Name (Z-A)</x:String>
                                <x:String>Population (High-Low)</x:String>
                                <x:String>Population (Low-High)</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>

                <Button Grid.Column="2"
                        Text="Reload"
                        Clicked="OnReloadClicked"
                        VerticalOptions="End"
                        Margin="0,0,0,2" />
            </Grid>

            <Label x:Name="ResultCountLabel"
                   Text="Loading countries..."
                   FontSize="13"
                   TextColor="Gray"
                   Margin="5,2,0,0" />
        </VerticalStackLayout>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">

            <!-- Loading Indicator -->
            <VerticalStackLayout x:Name="LoadingView"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="15"
                                 IsVisible="False">
                <ActivityIndicator x:Name="LoadingIndicator"
                                   IsRunning="True"
                                   HeightRequest="45"
                                   WidthRequest="45"
                                   Color="#2196F3" />
                <Label Text="Fetching latest data..." FontSize="14" TextColor="Gray" />
            </VerticalStackLayout>

            <!-- Error State -->
            <VerticalStackLayout x:Name="StatusMessageView"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Padding="30"
                                 Spacing="15"
                                 IsVisible="False">
                <Label x:Name="StatusMessageLabel"
                       Text="No countries found."
                       HorizontalTextAlignment="Center"
                       FontSize="16"
                       TextColor="Gray" />
                <Button Text="Try Again" Clicked="OnReloadClicked" WidthRequest="140" />
            </VerticalStackLayout>

            <!-- Pull to Refresh List -->
            <RefreshView x:Name="CountryRefreshView"
                         Refreshing="OnRefreshRequested">
                <CollectionView x:Name="CountriesCollectionView"
                                Margin="15,5,15,10"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12"
                                    Padding="12"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                                <Grid ColumnDefinitions="90, *" ColumnSpacing="15">
                                    <Image Grid.Column="0"
                                           Source="{Binding FlagUrl, FallbackValue='?'}"
                                           Aspect="AspectFit"
                                           HeightRequest="60"
                                           WidthRequest="90"
                                           VerticalOptions="Center" />

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                        <Label Text="{Binding CommonName}" FontAttributes="Bold" FontSize="17" />
                                        <Label Text="{Binding CapitalDisplay, StringFormat='Capital: {0}'}" FontSize="13" TextColor="Gray" />
                                        <Label Text="{Binding Region, StringFormat='Region: {0}'}" FontSize="13" TextColor="Gray" />
                                        <Label Text="{Binding FormattedPopulation, StringFormat='Pop: {0}'}" FontSize="12" TextColor="#2196F3" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCountrySelected" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>